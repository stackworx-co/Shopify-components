<div class="<%= ShopifyUI::DropdownSelectComponent::WRAPPER %>">
  <% if @label %>
    <label id="<%= label_id %>" for="<%= @id %>" class="<%= label_classes %>"><%= @label %></label>
  <% end %>
  <div <%= tag.attributes(root_attributes) %>>
    <button <%= tag.attributes(trigger_attributes) %>><span data-sui-select-value class="<%= ShopifyUI::DropdownSelectComponent::VALUE %><%= " #{ShopifyUI::DropdownSelectComponent::PLACEHOLDER}" unless display_text %>"><%= display_text || @placeholder || " " %></span></button>
    <svg class="<%= "#{ShopifyUI::DropdownSelectComponent::CHEVRON} #{ShopifyUI::DropdownSelectComponent::CHEVRON_COLORS[state]}" %>" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 8 4 4 4-4"/></svg>
    <%= native_select %>
    <% unless @disabled %>
      <ul <%= tag.attributes(list_attributes) %>>
        <% @groups.each_with_index do |(group, options), group_index| %>
          <% if group %><li role="presentation" class="<%= ShopifyUI::DropdownSelectComponent::GROUP %>"><%= group %></li><% end %>
          <% options.each_with_index do |option, index| %>
            <li role="option" id="<%= option_id(group_index, index) %>" class="<%= ShopifyUI::DropdownSelectComponent::OPTION.join(" ") %>" data-value="<%= option[:value] %>" data-label="<%= option[:label] %>" aria-selected="<%= selected?(option) %>"<% if option[:disabled] %> aria-disabled="true"<% end %>><svg class="<%= ShopifyUI::DropdownSelectComponent::CHECK %>" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 10.5 3.2 3L15 6.5"/></svg><span class="<%= ShopifyUI::DropdownSelectComponent::OPTION_LABEL %>"><%= option[:label] %></span></li>
          <% end %>
        <% end %>
      </ul>
    <% end %>
  </div>
  <% if @error.present? %>
    <p id="<%= @id %>-description" class="<%= ShopifyUI::DropdownSelectComponent::ERROR %>">
      <svg class="<%= ShopifyUI::DropdownSelectComponent::ERROR_ICON %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm-.75 4.5a.75.75 0 0 1 1.5 0v4a.75.75 0 0 1-1.5 0v-4ZM10 14.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"/></svg>
      <%= @error %>
    </p>
  <% elsif @help_text.present? %>
    <p id="<%= @id %>-description" class="<%= ShopifyUI::DropdownSelectComponent::HELP_TEXT %>"><%= @help_text %></p>
  <% end %>
</div>
<%= ShopifyUI::Runtime.script(self, :dropdown_select, ShopifyUI::DropdownSelectComponent::SCRIPT) %>
