<% if icon_trigger? %>
<button type="button" class="<%= ShopifyUI::DropdownMenuComponent::ICON_TRIGGER.join(" ") %>" <%= tag.attributes(trigger_attributes) %>>
  <% if @icon %>
  <%= @icon %>
  <% else %>
  <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true"><circle cx="5" cy="10" r="1.5"/><circle cx="10" cy="10" r="1.5"/><circle cx="15" cy="10" r="1.5"/></svg>
  <% end %>
</button>
<% else %>
<%= render(ShopifyUI::ButtonComponent.new(variant: @variant, size: @size, **trigger_attributes)) do %>
  <%= @label %>
  <svg class="<%= ShopifyUI::DropdownMenuComponent::CHEVRON %>" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 8 4 4 4-4"/></svg>
<% end %>
<% end %>
<div <%= tag.attributes(menu_attributes) %>>
  <% items.each do |item| %>
    <%= item %>
  <% end %>
</div>
