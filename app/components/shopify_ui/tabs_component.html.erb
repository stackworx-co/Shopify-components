<div <%= tag.attributes(root_attributes) %>>
  <div class="<%= ShopifyUI::TabsComponent::BAR[@variant] %>">
    <div <%= tag.attributes(list_attributes) %>>
      <% @tabs.each do |tab| %><%= tab_tag(tab) %><% end %>
    </div>
    <%= more_tag %>
    <%= add_tag %>
    <% @tabs.each do |tab| %><%= actions_menu(tab) %><% end %>
  </div>
  <% panels.each do |panel| %><%= panel %><% end %>
</div>
<script><%= raw ShopifyUI::TabsComponent::SCRIPT %></script>
