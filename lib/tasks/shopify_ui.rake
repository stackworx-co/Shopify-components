# frozen_string_literal: true

namespace :shopify_ui do
  desc "Write app/assets/stylesheets/shopify_ui.css, which imports the shopify_ui theme from the installed gem"
  task :tailwind do
    target = Rails.root.join("app", "assets", "stylesheets", "shopify_ui.css")
    target.write(<<~CSS)
      /* Generated by `bin/rails shopify_ui:tailwind` (shopify_ui #{ShopifyUI::VERSION}). Do not edit or commit. */
      @import "#{ShopifyUI.theme_css_path}";
    CSS
    puts "shopify_ui: wrote #{target.relative_path_from(Rails.root)}"
  end
end

# Regenerate before CSS builds, so deploys always point at the installed gem version.
task "assets:precompile" => "shopify_ui:tailwind"
Rake::Task["tailwindcss:build"].enhance(["shopify_ui:tailwind"]) if Rake::Task.task_defined?("tailwindcss:build")
