<div class="tw:mx-auto tw:max-w-5xl tw:px-6 tw:py-10">
  <header class="tw:mb-8">
    <h1 class="tw:m-0 tw:text-[24px] tw:font-semibold tw:text-ink">shopify-ui components</h1>
    <p class="tw:mt-1 tw:mb-0 tw:text-muted">Version <%= ShopifyUISetup.version %></p>
    <nav class="tw:mt-4 tw:flex tw:flex-wrap tw:gap-2">
      <% @sections.each do |name| %>
        <a href="#<%= name %>" class="tw:text-link tw:no-underline tw:hover:underline"><%= name.humanize %></a>
      <% end %>
    </nav>
  </header>

  <div class="tw:flex tw:flex-col tw:gap-6">
    <% @sections.each do |name| %>
      <section id="<%= name %>" class="tw:rounded-surface tw:border tw:border-border tw:bg-surface tw:p-6 tw:shadow-card">
        <h2 class="tw:m-0 tw:mb-4 tw:text-[16px] tw:font-semibold tw:text-ink"><%= name.humanize %></h2>
        <%= render "components/#{name}" %>
      </section>
    <% end %>
  </div>
</div>
