<% label_class = "tw:m-0 tw:mb-2 tw:text-[12px] tw:text-muted" %>
<% sections = [
  { items: [
    { label: "Home", icon: :home, href: "#" },
    { label: "Orders", icon: :orders, href: "#", count: 414, children: [
      { label: "Drafts", href: "#" }, { label: "Shipping labels", href: "#", active: true },
      { label: "Abandoned checkouts", href: "#" }
    ] },
    { label: "Products", icon: :products, href: "#", children: [ { label: "Collections", href: "#" }, { label: "Inventory", href: "#" } ] },
    { label: "Customers", icon: :customers, href: "#" },
    { label: "Marketing", icon: :growth, href: "#" },
    { label: "Discounts", icon: :discounts, href: "#" },
    { label: "Content", icon: :content, href: "#" },
    { label: "Markets", icon: :markets, href: "#" },
    { label: "Finance", icon: :finance, href: "#" },
    { label: "Analytics", icon: :analytics, href: "#" }
  ] },
  { title: "Sales channels", title_href: "#", items: [ { label: "Online Store", icon: :online_store, href: "#" } ] },
  { title: "Apps", title_href: "#", items: [ { label: "OOS Orders", icon: :orders, href: "#" } ] }
] %>

<p class="<%= label_class %>">Desktop: black frame, sidebar, rounded content panel that scrolls on its own. Below 1024px: black top bar + slide-in drawer.</p>
<div class="tw:overflow-hidden tw:rounded-[20px] tw:border tw:border-border tw:h-[680px] tw:max-lg:h-auto tw:[transform:translateZ(0)]">
  <%= render(ShopifyUI::AppFrameComponent.new(contained: true, main_id: "sidebar-demo-main")) do |frame| %>
    <% frame.with_sidebar(
         id: "sidebar-demo",
         sections: sections,
         footer_items: [ { label: "Settings", icon: :settings, href: "#" } ],
         store: { name: "Stackworx Store", badge: "dev", href: "#", notifications_href: "#" }) %>
    <div class="tw:mx-auto tw:max-w-3xl tw:p-6 tw:max-sm:p-4">
      <%= render(ShopifyUI::PageHeaderComponent.new(title: "Shipping labels", back_url: "#",
            secondary_actions: [ { label: "Export" } ], primary_action: { label: "Buy shipping label" })) %>
      <div class="tw:flex tw:flex-col tw:gap-4">
        <% 6.times do |i| %>
          <%= render(ShopifyUI::CardComponent.new(title: "Label batch #{i + 1}", edge_to_edge: false)) { tag.p("Scroll inside the panel — the frame and sidebar stay put.", class: "tw:m-0 tw:text-muted") } %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
