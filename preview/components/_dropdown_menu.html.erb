<% label_class = "tw:m-0 tw:mb-2 tw:text-[12px] tw:text-muted" %>
<% row_class = "tw:flex tw:flex-wrap tw:items-center tw:gap-2" %>
<% icon = ->(path) { tag.svg(tag.path(d: path), viewBox: "0 0 20 20", width: 20, height: 20, fill: "none", stroke: "currentColor", "stroke-width": 1.6, "stroke-linecap": "round", "stroke-linejoin": "round") } %>

<div class="tw:flex tw:flex-col tw:gap-6">
  <div>
    <p class="<%= label_class %>">Simple list</p>
    <div class="<%= row_class %>">
      <%= render(ShopifyUI::DropdownMenuComponent.new(label: "More actions")) do |menu| %>
        <% menu.with_action { "Duplicate" } %>
        <% menu.with_action { "Print packing slips" } %>
        <% menu.with_action { "Archive" } %>
        <% menu.with_action(destructive: true) { "Delete order" } %>
      <% end %>
    </div>
  </div>

  <div>
    <p class="<%= label_class %>">Icons, help text, sections, disabled and destructive items</p>
    <div class="<%= row_class %>">
      <%= render(ShopifyUI::DropdownMenuComponent.new(label: "Actions")) do |menu| %>
        <% menu.with_heading("Order") %>
        <% menu.with_action(icon: icon.call("M5 7h10M5 10h10M5 13h6")) { "Edit" } %>
        <% menu.with_action(icon: icon.call("M6 6h8v8H6zM4 4h8"), help_text: "Copies items and customer") { "Duplicate" } %>
        <% menu.with_action(icon: icon.call("M6 8V4h8v4M6 14H4V8h12v6h-2M6 12h8v4H6z")) { "Print" } %>
        <% menu.with_divider %>
        <% menu.with_heading("Fulfillment") %>
        <% menu.with_action(icon: icon.call("M3 6h9v8H3zM12 9h3l2 2v3h-5")) { "Create shipping label" } %>
        <% menu.with_action(disabled: true, icon: icon.call("M5 10l3 3 7-7")) { "Mark as fulfilled" } %>
        <% menu.with_divider %>
        <% menu.with_action(destructive: true, icon: icon.call("M5 6h10M8 6V4h4v2M6 6l1 10h6l1-10")) { "Cancel order" } %>
      <% end %>
    </div>
  </div>

  <div>
    <p class="<%= label_class %>">Trigger styles</p>
    <div class="<%= row_class %>">
      <%= render(ShopifyUI::DropdownMenuComponent.new(label: "Secondary")) do |menu| %>
        <% menu.with_action { "First action" } %>
        <% menu.with_action { "Second action" } %>
      <% end %>
      <%= render(ShopifyUI::DropdownMenuComponent.new(label: "Primary", variant: :primary)) do |menu| %>
        <% menu.with_action { "First action" } %>
        <% menu.with_action { "Second action" } %>
      <% end %>
      <%= render(ShopifyUI::DropdownMenuComponent.new(label: "Tertiary", variant: :tertiary, size: :slim)) do |menu| %>
        <% menu.with_action { "First action" } %>
        <% menu.with_action { "Second action" } %>
      <% end %>
      <%= render(ShopifyUI::DropdownMenuComponent.new(label: "Plain", variant: :plain)) do |menu| %>
        <% menu.with_action { "First action" } %>
        <% menu.with_action { "Second action" } %>
      <% end %>
      <%= render(ShopifyUI::DropdownMenuComponent.new(align: :end)) do |menu| %>
        <% menu.with_action(href: "#") { "View order" } %>
        <% menu.with_action { "Archive" } %>
        <% menu.with_action(destructive: true) { "Delete" } %>
      <% end %>
    </div>
  </div>
</div>
