<% label_class = "tw:m-0 tw:mb-2 tw:text-[12px] tw:text-muted" %>
<% icon = '<svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5 10 4l7 3.5v5L10 16l-7-3.5z"/><path d="M3 7.5 10 11l7-3.5M10 11v5"/></svg>'.html_safe %>

<div class="tw:flex tw:flex-col tw:gap-8">
  <div>
    <p class="<%= label_class %>">Sizes: page, section, card, subsection (title + subtitle)</p>
    <div class="tw:flex tw:flex-col tw:gap-6">
      <% ShopifyUI::HeadingComponent::SIZES.each_key do |size| %>
        <%= render(ShopifyUI::HeadingComponent.new(title: "#{size.to_s.humanize} title", subtitle: "Subtitle for the #{size} level. Wraps onto more lines when it is long, instead of overflowing on phones.", size: size)) %>
      <% end %>
    </div>
  </div>

  <div>
    <p class="<%= label_class %>">With badges and actions (actions wrap under the title on phones)</p>
    <%= render(ShopifyUI::HeadingComponent.new(title: "Shipping and delivery", subtitle: "Choose where you ship and how much you charge.", size: :section)) do |h| %>
      <% h.with_badge(tone: :success) { "Active" } %>
      <% h.with_actions do %>
        <%= render(ShopifyUI::ButtonComponent.new) { "Manage rates" } %>
        <%= render(ShopifyUI::ButtonComponent.new(variant: :primary)) { "Add zone" } %>
      <% end %>
    <% end %>
  </div>

  <div>
    <p class="<%= label_class %>">With an icon, multiple badges, plain link action</p>
    <%= render(ShopifyUI::HeadingComponent.new(title: "Domestic zone", subtitle: "United States · 3 rates", size: :card)) do |h| %>
      <% h.with_leading do %><span class="tw:inline-flex tw:size-9 tw:items-center tw:justify-center tw:rounded-[10px] tw:bg-surface-secondary tw:text-muted"><%= icon %></span><% end %>
      <% h.with_badge(tone: :info) { "Default" } %>
      <% h.with_badge(tone: :attention) { "Needs review" } %>
      <% h.with_actions do %><%= render(ShopifyUI::ButtonComponent.new(variant: :plain)) { "Edit" } %><% end %>
    <% end %>
  </div>

  <div>
    <p class="<%= label_class %>">Long title wraps, title only, custom level (h4 at card size)</p>
    <div class="tw:flex tw:flex-col tw:gap-6">
      <%= render(ShopifyUI::HeadingComponent.new(title: "The Collection Snowboard: Hydrogen — Limited Edition Winter 2026 Release", size: :section)) %>
      <%= render(ShopifyUI::HeadingComponent.new(title: "Notes", size: :card, level: 4)) %>
    </div>
  </div>
</div>
