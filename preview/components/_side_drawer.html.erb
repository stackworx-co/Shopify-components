<div class="tw:flex tw:flex-wrap tw:gap-3 tw:p-5">

  <%# Basic drawer trigger %>
  <%= tag.button(
    "Open basic drawer",
    type: "button",
    class: "tw:rounded-md tw:bg-fill-brand tw:px-4 tw:py-2 tw:text-white",
    **ShopifyUI::SideDrawerComponent.open_attributes("preview-basic-drawer")
  ) %>

  <%# Basic drawer %>
  <%= render ShopifyUI::SideDrawerComponent.new(
    id: "preview-basic-drawer",
    title: "Basic drawer",
    size: :medium,
    primary_action: { label: "Save changes" },
    secondary_actions: [{ label: "Cancel", close: true }]
  ) do %>
    <div class="tw:flex tw:flex-col tw:gap-4">
      <p>Basic drawer content.</p>

      <div class="tw:rounded-lg tw:border tw:border-border tw:p-4">
        <p class="tw:font-semibold">Drawer content</p>
        <p class="tw:mt-1 tw:text-muted">
          Use this variant for simple content that does not need separate sections.
        </p>
      </div>
    </div>
  <% end %>


  <%# Refund drawer trigger %>
  <%= tag.button(
    "Open refund drawer",
    type: "button",
    class: "tw:rounded-md tw:border tw:border-border tw:px-4 tw:py-2",
    **ShopifyUI::SideDrawerComponent.open_attributes("preview-refund-drawer")
  ) %>

  <%# Structured refund drawer %>
  <%= render ShopifyUI::SideDrawerComponent.new(
    id: "preview-refund-drawer",
    title: "Refund items",
    size: :medium,
    sectioned: true,
    primary_action: {
      label: "Refund",
      destructive: true
    },
    secondary_actions: [
      { label: "Cancel", close: true }
    ]
  ) do |drawer| %>

    <%# Section 1: Items to refund %>
    <% drawer.with_section do %>
      <div class="tw:flex tw:flex-col tw:gap-3">

        <h3 class="tw:m-0 tw:text-[13px] tw:font-semibold tw:text-ink">
          Items to refund
        </h3>

        <div class="tw:flex tw:flex-col tw:divide-y tw:divide-border-secondary">

          <% [
            { name: "Nike Air Max 90", spec: "Size 9 · Black", price: "$120.00" },
            { name: "Nike Dunk Low", spec: "Size 10 · White", price: "$110.00" },
            { name: "Nike Air Force 1", spec: "Size 8 · White", price: "$100.00" }
          ].each do |item| %>

            <label class="tw:flex tw:min-w-0 tw:items-center tw:gap-3 tw:py-3">
              <input
                type="checkbox"
                checked
                class="tw:size-4 tw:shrink-0 tw:accent-current">

              <span class="tw:flex tw:size-11 tw:shrink-0 tw:items-center tw:justify-center tw:rounded-md tw:bg-fill-tertiary">
                <svg
                  viewBox="0 0 24 24"
                  class="tw:size-5 tw:text-muted"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true">
                  <path d="M3 8h18l-2 12H5L3 8Z"/>
                  <path d="M8 8a4 4 0 0 1 8 0"/>
                </svg>
              </span>

              <span class="tw:flex tw:min-w-0 tw:flex-1 tw:flex-col">
                <span class="tw:truncate tw:font-medium tw:text-ink">
                  <%= item[:name] %>
                </span>
                <span class="tw:text-xs tw:text-muted">
                  <%= item[:spec] %>
                </span>
              </span>

              <span class="tw:shrink-0 tw:text-[13px] tw:font-medium tw:text-ink">
                <%= item[:price] %>
              </span>
            </label>

          <% end %>

        </div>
      </div>
    <% end %>


    <%# Section 2: Summary %>
    <% drawer.with_section do %>
      <div class="tw:flex tw:flex-col tw:gap-3">

        <h3 class="tw:m-0 tw:text-[13px] tw:font-semibold tw:text-ink">
          Summary
        </h3>

        <div class="tw:flex tw:items-center tw:justify-between tw:gap-3">
          <span class="tw:text-muted">Items (3)</span>
          <span>$330.00</span>
        </div>

        <div class="tw:flex tw:items-center tw:justify-between tw:gap-3">
          <span class="tw:text-muted">Tax</span>
          <span>$26.40</span>
        </div>

        <div class="tw:flex tw:items-center tw:justify-between tw:gap-3">
          <span class="tw:text-muted">Shipping</span>
          <span>$10.00</span>
        </div>

        <div class="tw:flex tw:items-center tw:justify-between tw:gap-3 tw:border-t tw:border-border tw:pt-3 tw:font-semibold">
          <span>Total refund</span>
          <span>$366.40 USD</span>
        </div>

      </div>
    <% end %>


    <%# Section 3: Original order refund %>
    <% drawer.with_section do %>
      <div class="tw:flex tw:flex-col tw:gap-3">

        <div>
          <h3 class="tw:m-0 tw:text-[13px] tw:font-semibold tw:text-ink">
            Original order refund
          </h3>

          <p class="tw:mt-1 tw:text-xs tw:text-muted">
            Method: Original payment method
          </p>
        </div>

        <div class="tw:flex tw:flex-col tw:gap-2">
          <label
            for="preview_refund_amount"
            class="tw:text-[13px] tw:font-medium tw:text-ink">
            Amount
          </label>

          <div class="tw:flex tw:items-center tw:overflow-hidden tw:rounded-md tw:border tw:border-border tw:bg-surface">
            <span class="tw:border-r tw:border-border tw:bg-surface-secondary tw:px-3 tw:py-2 tw:text-muted">
              USD
            </span>

            <input
              id="preview_refund_amount"
              type="text"
              value="366.40"
              readonly
              class="tw:min-w-0 tw:flex-1 tw:border-0 tw:bg-transparent tw:px-3 tw:py-2 tw:text-ink tw:outline-none">
          </div>

          <p class="tw:text-xs tw:leading-5 tw:text-muted">
            This refunds the selected items, including applicable tax and shipping.
            The refund cannot be undone.
          </p>
        </div>

      </div>
    <% end %>

  <% end %>

</div>